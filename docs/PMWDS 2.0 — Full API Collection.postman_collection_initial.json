    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "",
                  "// Save token and user data",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    console.log('✓ Token saved');",
                  "}",
                  "if (res.userId) {",
                  "    pm.collectionVariables.set('userId', res.userId);",
                  "}",
                  "if (res.fullName) {",
                  "    pm.environment.set('fullName', res.fullName);",
                  "}",
                  "if (res.email) {",
                  "    pm.environment.set('email', res.email);",
                  "}",
                  "",
                  "// Save expiry - convert string to timestamp",
                  "if (res.expiry) {",
                  "    var expiryDate = new Date(res.expiry);",
                  "    pm.environment.set('tokenExpiry', res.expiry);",
                  "    pm.environment.set('tokenExpiryTimestamp', expiryDate.getTime());",
                  "    console.log('✓ Token valid until: ' + expiryDate.toLocaleString());",
                  "}",
                  "",
                  "pm.test('Login successful', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(res.token).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n \"email\": \"admin@pmwds.com\",\n \"password\": \"Admin@12345!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Auth",
                "login"
              ]
            }
          },
          "response": []
        },
