  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// ============================================",
          "// COLLECTION-LEVEL PRE-REQUEST SCRIPT",
          "// ============================================",
          "",
          "// Skip token check for auth endpoints",
          "const url = pm.request.url.toString();",
          "const isAuthEndpoint = url.includes('/Auth/login');",
          "",
          "if (isAuthEndpoint) {",
          "    console.log('Auth endpoint - skipping token check');",
          "    return;",
          "}",
          "",
          "// Get token from collection variables",
          "let token = pm.collectionVariables.get('token');",
          "let expiry = pm.collectionVariables.get('tokenExpiry');",
          "",
          "if (!token) {",
          "    // Try environment variable",
          "    token = pm.environment.get('token');",
          "    expiry = pm.environment.get('tokenExpiry');",
          "}",
          "",
          "if (!token) {",
          "    throw new Error('No token. Run Login first.');",
          "}",
          "",
          "// Check if token is expired or about to expire",
          "if (expiry) {",
          "    const now = new Date();",
          "    const expiryDate = new Date(expiry);",
          "    const fiveMinutes = 5 * 60 * 1000;",
          "",
          "    if (expiryDate <= now) {",
          "        throw new Error('Token expired. Run Login.');",
          "    }",
          "    ",
          "    if ((expiryDate - now) <= fiveMinutes) {",
          "        console.log('Token expires soon. Consider refreshing.');",
          "    }",
          "}",
          "",
          "console.log('Token OK');"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "// ============================================",
          "// COLLECTION-LEVEL TEST SCRIPT",
          "// ============================================",
          "",
          "// Log response time",
          "const time = pm.response.responseTime;",
          "console.log('Response time: ' + time + 'ms');",
          "",
          "// Auto-save token on refresh",
          "if (pm.request.url.includes('/Auth/refresh')) {",
          "    const res = pm.response.json();",
          "    if (res.token) {",
          "        pm.collectionVariables.set('token', res.token);",
          "        if (res.expiry) {",
          "            pm.collectionVariables.set('tokenExpiry', res.expiry);",
          "        }",
          "        console.log('✓ Token refreshed');",
          "    }",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
