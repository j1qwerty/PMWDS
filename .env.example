# PMWDS configuration.
#
# Copy this file to `.env` and fill in the values. Every secret the application
# uses is read from here or from real environment variables - nothing is
# committed to source.
#
# Precedence: a real environment variable always wins over this file. That
# means `docker run -e ...`, a systemd `Environment=` line, or an orchestrator
# secret can override anything below without editing the file.
#
# Leave a value blank to skip it. Blank values and unfilled placeholders
# (anything containing CHANGE_ME or "replace-with") are ignored, so a blank
# key here never shadows a correctly configured one supplied elsewhere.


# ─── Docker infrastructure ────────────────────────────────────────────────────
ACCEPT_EULA=Y
# SQL Server container's sa password. Must satisfy the SQL Server password
# policy: at least 8 characters, with upper case, lower case, a digit, and a
# symbol. It has to match ConnectionStrings__Default below.
SA_PASSWORD=CHANGE_ME_Strong_Passw0rd


# ─── Database ─────────────────────────────────────────────────────────────────
# SQL Server is attempted first; SQLite is the fallback in Development.
#
# Set Database__EnableSqlServer=false on a deployment that has no SQL Server and
# no intention of gaining one - the sqlite production variant on the VPS. The
# startup probe is skipped entirely, so the app does not burn a connect timeout
# every boot waiting for an instance that is never there, and it cannot silently
# switch itself to SQL Server if something else happens to listen on 1433.
# Defaults to true. Requires Database__AllowSqliteInProduction=true to run
# outside Development.
Database__EnableSqlServer=true
#
# SQL Server AUTHENTICATION ONLY. Do not use Trusted_Connection=True /
# Integrated Security=True here: Windows authentication does not exist on
# Linux, so it works on a Windows dev box and fails on the Ubuntu VPS. Every
# deployed environment must supply User Id + Password.
#
# Use 127.0.0.1 rather than localhost - some SQL Server instances (including the
# official Linux container) do not answer on ::1, and the connection hangs until
# it times out.
#
# TrustServerCertificate=True is required for the self-signed certificate the
# SQL Server container generates on first run.
#
# Do NOT add MultipleActiveResultSets=true. EF Core enables a retry strategy for
# SQL Server (EnableRetryOnFailure), and that strategy relies on savepoints -
# MARS disables them, so EF logs "Savepoints are disabled because Multiple Active
# Result Sets is enabled" on every save and cannot roll back a failed transaction
# to a clean state before retrying. EF Core does not need MARS.
ConnectionStrings__Default=Server=127.0.0.1,1433;Database=PMWDS;User Id=sa;Password=CHANGE_ME_Strong_Passw0rd;TrustServerCertificate=True
ConnectionStrings__Hangfire=Server=127.0.0.1,1433;Database=PMWDS_Hangfire;User Id=sa;Password=CHANGE_ME_Strong_Passw0rd;TrustServerCertificate=True

# Redis is used for app cache. Optional: if Redis is unreachable the app logs a
# warning and falls back to an in-memory distributed cache.
ConnectionStrings__Redis=localhost:6379

# Database fallback switches. ForceSqlite is allowed only in Development.
Database__ForceSqlite=false
Database__SqliteConnectionString=Data Source=App_Data/pmwds-dev.sqlite

# Production on SQL Server: keep ForceSqlite false and leave the SQLite opt-in
# off, so a bad connection string fails loudly instead of silently starting on an
# empty SQLite file.
Database__AllowSqliteInProduction=false

# Production on SQLite (single instance, no Hangfire) - opt in explicitly and use
# an absolute path outside the publish folder so the DB survives redeploys.
# Database__AllowSqliteInProduction=true
# Database__SqliteConnectionString=Data Source=/var/lib/pmwds/database/pmwds.sqlite


# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a cryptographically random secret (>=64 chars) for production.
# The app refuses to start if this is missing or shorter than 32 bytes.
#   openssl rand -base64 48
Jwt__Secret=replace-with-random-secret-min-64-chars
Jwt__Issuer=PMWDS
Jwt__Audience=PMWDS_Users
Jwt__ExpiryMinutes=30
Jwt__RefreshTokenDays=14


# ─── Seed accounts ────────────────────────────────────────────────────────────
# Password given to every account created by the seeder on first run:
# superadmin@org1.com, admin@org1.com, manager@org1.com, and the department
# heads and members listed in the seeder.
#
# There is deliberately no default in the code. If this is missing, seeding
# fails with a message naming this key rather than creating accounts with a
# password that is published in the repository. Change it after first login.
#
# Only used when a user does not already exist - it never resets an existing
# account's password on a later boot.
Seed__DefaultPassword=CHANGE_ME_Strong_Passw0rd


# ─── AI providers ─────────────────────────────────────────────────────────────
# The provider and model used for chat, report generation, and summaries.
#
# Model size dominates report latency: a 550B free-tier model can take minutes
# per report. Raise AI__RequestTimeoutSeconds, or switch to a smaller model for
# faster generation.
#
# NOTE on ":free" models: OpenRouter allows 50 requests per day per account on
# free models, shared across every user of this deployment. Once spent, the AI
# assistant and report generation return 429 ai_provider_rate_limited until the
# daily reset (00:00 UTC). Add 10 credits to OpenRouter, or point
# AI__DefaultModel / AI__OpenRouter__DefaultModel at a paid model, before this
# becomes a production problem.
AI__DefaultProvider=OpenRouter
AI__DefaultModel=nvidia/nemotron-3-ultra-550b-a55b:free
# Model to switch to when AI__DefaultModel (or whatever model is selected) returns
# HTTP 429. openrouter/free is OpenRouter's router model: it picks a currently
# available free model at random and filters for the features the request needs.
# Because it is a router rather than one named model, it draws on a different quota
# bucket, so it still answers when a specific free model is exhausted.
#
# Set AI__EnableRateLimitFallback=false to fail immediately on 429 instead, or blank
# AI__RateLimitFallbackModel to disable the retry entirely. OpenRouter only - this
# is an OpenRouter model id and OpenAI will reject it with a 404.
#
# The retry happens once per request. If the fallback is also rate limited the
# response is a 429 naming both models, which means the whole key has no quota left
# and only more credits will help.
AI__RateLimitFallbackModel=openrouter/free
AI__EnableRateLimitFallback=true
# Provider call timeout. The .NET HttpClient default is 100s, which is too short
# for large structured report completions on a large model.
AI__RequestTimeoutSeconds=600
AI__MaxOutputTokens=16000
# A task is treated as high risk at or above this delay probability.
AI__RiskThreshold=0.7

# OpenAI. Leave the key blank to use only OpenRouter.
AI__OpenAI__ApiKey=
AI__OpenAI__BaseUrl=https://api.openai.com/v1
AI__OpenAI__DefaultModel=gpt-4o

# OpenRouter. The key here is the one the seeder stores, so the AI page and
# report generation work on a fresh database.
AI__OpenRouter__ApiKey=
AI__OpenRouter__BaseUrl=https://openrouter.ai/api/v1
AI__OpenRouter__DefaultModel=nvidia/nemotron-3-ultra-550b-a55b:free

# Sent to OpenRouter so requests are attributable to this deployment.
AI__AppUrl=http://localhost:5177
AI__AppName=PMWDS


# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# When these are blank, email is disabled and priority notifications stay
# in-app only.
Email__Host=
Email__Port=587
Email__Username=
Email__Password=
Email__SenderEmail=no-reply@pmwds.local
Email__SenderName=PMWDS
Email__UseSsl=true
Email__ClientBaseUrl=http://localhost:5173
Email__PasswordResetMinutes=30


# ─── File storage ─────────────────────────────────────────────────────────────
# Root for uploaded documents and avatars. Leave blank to use the
# App_Data folder next to the application.
# FileStorage__BasePath=/var/lib/pmwds/data
FileStorage__AvatarsPath=avatars
FileStorage__DocumentsPath=documents
# Public path the files above are served from.
AzureStorage__LocalUploadPath=App_Data
AzureStorage__LocalBaseUrl=/files


# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API. Must include the origin the
# client is served from, or every browser request is rejected.
AllowedOrigins__0=http://localhost:5173
AllowedOrigins__1=http://localhost:5177


# ─── Logging ──────────────────────────────────────────────────────────────────
# One of Verbose, Debug, Information, Warning, Error, Fatal.
Serilog__MinimumLevel__Default=Information
