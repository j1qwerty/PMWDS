# PMWDS backend configuration. Copy to .env and update local values.

# SQL Server is attempted first.
ConnectionStrings__Default=Server=.;Database=PMWDS;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# MySQL is attempted second when SQL Server cannot connect.
ConnectionStrings__MySql=Server=localhost;Port=3306;Database=pmwds;User=pmwds;Password=change-me;

# Hangfire currently runs only when SQL Server is active.
ConnectionStrings__Hangfire=Server=.;Database=PMWDS_Hangfire;Trusted_Connection=True;TrustServerCertificate=True

# Redis is used for app cache.
ConnectionStrings__Redis=localhost:6379

# Database fallback switches. Fallback order is SQL Server, MySQL, then SQLite.
Database__EnableMySqlFallback=true
Database__EnableSqliteFallback=true
Database__ForceSqlite=false
Database__SqliteConnectionString=Data Source=App_Data/pmwds-dev.sqlite

# JWT secret for local development. Replace before production.
Jwt__Secret=PMWDS_SuperSecretKey_2025_ChangeInProduction!
Jwt__Issuer=PMWDS
Jwt__Audience=PMWDS_Users
Jwt__ExpiryMinutes=480

# AI defaults. Leave API keys empty to manage providers from the Settings page.
AI__DefaultProvider=OpenAI
AI__DefaultModel=gpt-oss-120b
AI__OpenAIApiKey=
AI__OpenAI__ApiKey=
AI__OpenAI__BaseUrl=https://api.openai.com/v1
AI__OpenAI__DefaultModelgpt-oss-120b
AI__OpenRouter__ApiKey=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
AI__OpenRouter__BaseUrl=https://openrouter.ai/api/v1
AI__OpenRouter__DefaultModel=openai/gpt-oss-120b:free

# SMTP and password reset mail.
# Development defaults target Mailtrap sandbox SMTP through MailKit.
Email__Host=sandbox.smtp.mailtrap.io
Email__Port=2525
Email__Username=dcb164eb0bb1ac
Email__Password=32fe7cf27e823f
Email__SenderEmail=no-reply@pmwds.local
Email__SenderName=PMWDS
Email__UseSsl=true
Email__ClientBaseUrl=http://localhost:5173
Email__PasswordResetMinutes=30
